# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE SHEETS INTEGRATION (100% Free via Google Apps Script Web App - No Service Account or Private Key needed!)
# Built directly into Google Sheets: Extensions -> Apps Script -> Deploy as Web App (Access: Anyone)
GOOGLE_SHEET_WEBHOOK_URL=""

# PAYMOB INTEGRATION SETTINGS: Real Egyptian payment gateway credentials for live & sandbox checkout
PAYMOB_API_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_SECRET_KEY=""
PAYMOB_INTEGRATION_ID_CARD=""
PAYMOB_INTEGRATION_ID_WALLET=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC=""

# REAL EMAIL VERIFICATION (100% Free, Zero-Cost Alternatives)
# 1. Firebase Authentication: Free unlimited email verification links & 1-Click Google Sign-In ($0 on Spark plan)
# 2. Free Gmail SMTP (Optional for server-dispatched 6-digit OTP codes, 500 free emails/day via Google App Password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
